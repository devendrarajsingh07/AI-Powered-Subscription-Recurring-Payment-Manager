ENVIRONMENT=development
DEMO_ENABLED=true
# Copy to .env. Change these local-only credentials before sharing a deployment.
POSTGRES_DB=subtrack
POSTGRES_USER=subtrack
POSTGRES_PASSWORD=subtrack_local_only
DATABASE_URL=postgresql+psycopg://subtrack:subtrack_local_only@db:5432/subtrack
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_ACCESS_MINUTES=30
JWT_ISSUER=subtrack
JWT_AUDIENCE=subtrack-web
BCRYPT_ROUNDS=12
AUTH_REGISTER_LIMIT=5
AUTH_LOGIN_LIMIT=10
AUTH_WINDOW_SECONDS=60
AUTH_SESSION_LIMIT=60
AUTH_REFRESH_DAYS=14
ACCOUNT_TOKEN_MINUTES=15
ACCOUNT_BACKOFF_THRESHOLD=3
# Strict mode uses rotating Secure/HttpOnly/SameSite=Strict host-only refresh cookies.
# REQUIRE_EMAIL_VERIFICATION=true
# API_ORIGIN=https://api.your-owned-domain.example
# AUTH_COOKIE_SITE=your-owned-domain.example
# Public free demo ONLY: PUBLIC_DEMO_ONLY=true and AUTH_SESSION_MODE=demo together.
# This disables uploads/password login/registration and requires fake AI + console notifier.
# Production rejects demo mode and requires HTTPS same-site sibling origins.
# Open is development/demo only. Production defaults closed and rejects open.
REGISTRATION_MODE=open
APP_TIMEZONE=Asia/Kolkata
UPLOAD_WORKERS=2
UPLOAD_QUEUE_LIMIT=8
WEB_ORIGIN=http://localhost:5173
VITE_API_BASE_URL=/api/v1
VITE_API_PROXY_TARGET=http://api:8000
VITE_USE_POLLING=true
API_PORT=8000
WEB_PORT=5173
# Offline by default. Live mode requires gemini, a key, a model and per-user consent.
LLM_PROVIDER=fake
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=https://generativelanguage.googleapis.com
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=20
LLM_RETRIES=2
CHAT_TIMEOUT_SECONDS=60
CHAT_HISTORY_WINDOW=8
CHAT_MINUTE_LIMIT=10
CHAT_DAILY_LIMIT=100
# Synthetic browser tests temporarily set this; leave empty for normal use.
APP_TEST_AS_OF=
NOTIFIER_PROVIDER=console
SCHEDULER_ENABLED=true
ALERT_JOB_HOUR=9
ALERT_JOB_MINUTE=0
ALERT_MAX_ATTEMPTS=3
ALERT_RETRY_SECONDS=300
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SECURITY=starttls
SMTP_TIMEOUT_SECONDS=10
HIGH_COST_YEARLY_INR=12000
HIGH_COST_SHARE=0.35
UNUSED_DAYS=60
STATEMENT_MAX_MB=10
STATEMENT_MAX_PAGES=30
STATEMENT_MAX_MEGAPIXELS=25
STATEMENT_TIMEOUT_SECONDS=120
STATEMENT_PAGE_SECONDS=20
STATEMENT_MEMORY_MB=512
STATEMENT_PREVIEW_TTL_MINUTES=30
STATEMENT_DAILY_LIMIT=20
STATEMENT_CONCURRENT_LIMIT=2

