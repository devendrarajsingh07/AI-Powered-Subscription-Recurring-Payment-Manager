# Copy to .env. Change these local-only credentials before sharing a deployment.
POSTGRES_DB=subtrack
POSTGRES_USER=subtrack
POSTGRES_PASSWORD=subtrack_local_only
DATABASE_URL=postgresql+psycopg://subtrack:subtrack_local_only@db:5432/subtrack
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_ACCESS_MINUTES=30
JWT_ISSUER=subtrack
JWT_AUDIENCE=subtrack-web
BCRYPT_ROUNDS=12
AUTH_REGISTER_LIMIT=5
AUTH_LOGIN_LIMIT=10
AUTH_WINDOW_SECONDS=60
APP_TIMEZONE=Asia/Kolkata
UPLOAD_WORKERS=2
UPLOAD_QUEUE_LIMIT=8
WEB_ORIGIN=http://localhost:5173
VITE_API_BASE_URL=/api/v1
VITE_API_PROXY_TARGET=http://api:8000
VITE_USE_POLLING=true
API_PORT=8000
WEB_PORT=5173
# Future phases will implement these adapters; they are not active yet.
LLM_PROVIDER=fake
LLM_API_KEY=
LLM_MODEL=
NOTIFIER_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
ALERT_LEAD_DAYS=3
HIGH_COST_YEARLY_INR=12000

