{
  "name": "subtrack-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node node_modules/vite/bin/vite.js --host 0.0.0.0",
    "build": "node scripts/types.mjs --check && node node_modules/typescript/bin/tsc -b && node node_modules/vite/bin/vite.js build",
    "typecheck": "node node_modules/typescript/bin/tsc -b --pretty false",
    "lint": "node node_modules/eslint/bin/eslint.js .",
    "test": "node node_modules/vitest/vitest.mjs",
    "types": "node scripts/types.mjs",
    "types:check": "node scripts/types.mjs --check",
    "e2e": "node node_modules/@playwright/test/cli.js test"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.74.4",
    "lucide-react": "^1.59.0",
    "openapi-fetch": "^0.17.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.5.3",
    "recharts": "^3.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.1.4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.15.2",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.4.1",
    "axe-core": "^4.14.0",
    "eslint": "^9.25.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.0.0",
    "jsdom": "^26.1.0",
    "msw": "^2.15.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.4",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.31.1",
    "vite": "^6.3.4",
    "vitest": "^4.1.12",
    "vitest-axe": "^0.1.0"
  }
